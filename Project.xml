<?xml version="1.0" encoding="utf-8"?>
<project>
	<!--
		Friday Night Funkin' (Psych Engine 0.6.3) — versão MOBILE
		Compatibilidade Android feita sob medida para este projeto (controles por hitbox,
		opções de desempenho e carregamento de mods no armazenamento do aparelho).

		Base do jogo: Psych Engine 0.6.3 (Apache-2.0) — 100% do conteúdo das Semanas 1-3.
	-->

	<app title="Friday Night Funkin' Mobile" file="FNFMobile" packageName="com.fnfmobile.game" package="com.fnfmobile.game" main="Main" version="1.0.0" company="Personal Build" />

	<!--Switch Export with Unique ApplicationID and Icon-->
	<set name="APP_ID" value="0x0100f6c013bbc000" />

	<haxedef name="LINC_LUA_RELATIVE_DYNAMIC_LIB"/>

	<app preloader="flixel.system.FlxPreloader" />

	<set name="SWF_VERSION" value="11.8" />

	<!-- ____________________________ Window Settings ___________________________ -->

	<window width="1280" height="720" fps="" background="#000000" hardware="true" vsync="false" />

	<!--HTML5-specific-->
	<window if="html5" resizable="true" />

	<!--Desktop-specific-->
	<window if="desktop" orientation="landscape" fullscreen="false" resizable="true" vsync="false"/>

	<!--Mobile-specific: tela cheia, paisagem, vsync desligado (permite limitar FPS pelo jogo)-->
	<window if="mobile" orientation="landscape" fullscreen="true" width="0" height="0" resizable="false" vsync="false"/>

	<!-- _____________________________ Path Settings ____________________________ -->

	<set name="BUILD_DIR" value="export/debug" if="debug" />
	<set name="BUILD_DIR" value="export/release" unless="debug" />
	<set name="BUILD_DIR" value="export/32bit" if="32bits" />

	<classpath name="source" />

	<!-- ______________________________ Android _________________________________ -->
	<!--
		Configuração do projeto Gradle gerado pelo Lime:
		 - minSdk 21 (Android 5.0) => roda em praticamente qualquer aparelho
		 - targetSdk 28 => modo de armazenamento legado, que é o que permite ler
		   a pasta de mods em /sdcard/FNF-Mobile/mods sem pedir permissão especial
		 - permissões de vibração/armazenamento usadas pelos controles e mods
	-->
	<android minimum-sdk-version="21" target-sdk-version="28" install-location="auto" gradle-version="6.7.1" />
	<config:android gradle-plugin="4.1.3" build-tools-version="30.0.3" />
	<android permission="android.permission.VIBRATE" />
	<android permission="android.permission.WAKE_LOCK" />
	<android permission="android.permission.INTERNET" />
	<android permission="android.permission.ACCESS_NETWORK_STATE" />
	<android permission="android.permission.WRITE_EXTERNAL_STORAGE" />
	<android permission="android.permission.READ_EXTERNAL_STORAGE" />


	<!-- PSYCH ENGINE CUSTOMIZATION -->
	<!-- Mods habilitados também no Android: as pastas ficam no armazenamento do
	     aparelho (ver mobile/MobilePlatform.hx). É o mesmo sistema de mods do Psych. -->
	<define name="MODS_ALLOWED" if="desktop || mobile" />
	<define name="LUA_ALLOWED" if="desktop" />
	<define name="ACHIEVEMENTS_ALLOWED" />
	<define name="VIDEOS_ALLOWED" if="web || windows" unless="32bits"/>
	<define name="PSYCH_WATERMARKS"/>
	<define name="TITLE_SCREEN_EASTER_EGG" if="officialBuild"/>
	<define name="CRASH_HANDLER" if="desktop release" />

	<!-- Semanas 1-3 apenas: os assets das semanas 4-7 não são baixados nem empacotados -->
	<assets path="assets/preload" rename="assets" exclude="*.ogg" if="web"/>
	<assets path="assets/preload" rename="assets" exclude="*.mp3"  unless="web"/>

	<!-- DONT ENABLE THIS -->
	<define name="CHECK_FOR_UPDATES" if="desktop officialBuild"/>

	<!--
		PRELOAD_ALL despeja TODOS os assets na RAM no boot (ótimo no PC, ruim em celular fraco).
		No mobile os assets são carregados sob demanda => menos RAM, menos travadas.
	-->
	<define name="PRELOAD_ALL" if="desktop" />
	<define name="NO_PRELOAD_ALL" unless="desktop"/>

	<section if="PRELOAD_ALL">
		<library name="songs"         preload="true" />
		<library name="shared"        preload="true" />
		<library name="week2"         preload="true" />
		<library name="week3"         preload="true" />
	</section>

	<section if="NO_PRELOAD_ALL">
		<library name="songs"         preload="false" />
		<library name="shared"        preload="false" />
		<library name="week2"         preload="false" />
		<library name="week3"         preload="false" />
	</section>

	<assets path="assets/songs"         library="songs"         exclude="*.ogg" if="web"/>
	<assets path="assets/songs"         library="songs"         exclude="*.mp3" unless="web"/>
	<assets path="assets/shared"        library="shared"        exclude="*.ogg" if="web"/>
	<assets path="assets/shared"        library="shared"        exclude="*.mp3" unless="web"/>
	<assets path="assets/week2"         library="week2"         exclude="*.ogg" if="web"/>
	<assets path="assets/week2"         library="week2"         exclude="*.mp3" unless="web"/>
	<assets path="assets/week3"         library="week3"         exclude="*.ogg" if="web"/>
	<assets path="assets/week3"         library="week3"         exclude="*.mp3" unless="web"/>

	<!-- No Android os mods são lidos da pasta do aparelho (não do APK), por isso
	     os mods de exemplo só são empacotados no desktop. -->
	<section if="desktop">
		<assets path='example_mods' rename='mods' embed='false'/>
	</section>
	<assets path='art/readme.txt' rename='do NOT readme.txt' />

	<assets path="assets/fonts" embed='true'/>

	<!-- _______________________________ Libraries ______________________________ -->

	<haxelib name="flixel" />
	<haxedev set='webgl' />

	<haxelib name="flixel-addons" />
	<haxelib name="hscript" />
	<define name="hscriptPos" />

	<haxelib name="flixel-ui" />
	<haxelib name="linc_luajit" if="LUA_ALLOWED"/>
	<haxelib name="hxCodec" if="VIDEOS_ALLOWED"/>
	<haxelib name="faxe" if='switch'/>
	<haxelib name="discord_rpc" if="desktop"/>

	<!-- ______________________________ Haxedefines _____________________________ -->

	<haxedef name="FLX_NO_FOCUS_LOST_SCREEN" />

	<haxedef name="HXC_DEBUG_TRACE" if="debug" />

	<haxedef name="FLX_NO_DEBUG" unless="debug" />

	<haxedef name="NAPE_RELEASE_BUILD" unless="debug" />

	<haxedef name="HXCPP_CHECK_POINTER" if="CRASH_HANDLER" />
	<haxedef name="HXCPP_STACK_LINE" if="CRASH_HANDLER" />

	<!-- _________________________ Android / Mobile _____________________________ -->

	<!--
		ABIs: arm64-v8a (aparelhos modernos) + armeabi-v7a (aparelhos antigos/fracos).
		O script tools/ci_build.sh pode remover a v7a para builds rápidos de teste.
	-->
	<architecture name="arm64" exclude="x86,x86_64" />
	<architecture name="armv7" />

	<!--
		AGP 4.1.3 + Gradle 6.7.1: combinação estável com NDK r21e e JDK 8.
		minSdk 21 = Android 5.0 (cobre aparelhos bem antigos).
		targetSdk 30: comportamento previsível de armazenamento para os mods.
	-->
	<config:android
		minimum-sdk-version="21"
		target-sdk-version="30"
		build-tools-version="30.0.3"
		gradle-version="6.7.1"
		gradle-plugin="4.1.3"
		install-location="auto" />

	<!-- _________________________________ Custom _______________________________ -->

	<icon path="art/icon16.png" size='16'/>
	<icon path="art/icon32.png" size='32'/>
	<icon path="art/icon64.png" size='64'/>
	<icon path="art/iconOG.png" />
</project>
